---
import { getSite } from "../lib/content";
import { url } from "../lib/paths";
import { wordmarkParts } from "../lib/view";
import Mark from "./Mark.astro";

const site = await getSite();
const parts = wordmarkParts(site.acronym);
---

<a class="brand" href={url("/")}>
  <Mark class="brand__mark" />
  <span class="brand__name">
    {parts ? (
      <>
        {parts.before}
        <span class="brand__digit">{parts.digit}</span>
        {parts.after}
      </>
    ) : (
      site.acronym
    )}
  </span>{" "}
  <span class="brand__year">{site.year}</span>
</a>
