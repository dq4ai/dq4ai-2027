---
import { TBA } from "../lib/dates";

interface Props {
  of: string | number;
  /** What an unknown value reads as. Past facts are not "to be announced". */
  unknown?: string;
}
const { of: value, unknown = "To be announced" } = Astro.props;
---

{value === TBA ? <span class="tba">{unknown}</span> : value}
