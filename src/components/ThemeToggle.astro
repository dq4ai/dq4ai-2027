<button class="icon-button theme-toggle" type="button" aria-label="Toggle dark theme">
  <svg
    class="theme-toggle__light"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg
    class="theme-toggle__dark"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  // The inline bootstrap in src/lib/theme.ts handles clicks, so the button works without this file.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const systemDark = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : systemDark.matches);
  const syncState = () => {
    button?.setAttribute("aria-pressed", String(isDark()));
  };
  const syncToolbar = () => {
    // Both tags are keyed to the system preference, which a changed theme can override.
    const background = getComputedStyle(document.body).backgroundColor;
    for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
      meta.setAttribute("content", background);
    }
  };
  const changed = () => {
    syncState();
    syncToolbar();
  };
  const applyStored = () => {
    try {
      const stored = localStorage.getItem("theme");
      if (stored === "dark" || stored === "light") root.dataset.theme = stored;
      else delete root.dataset.theme;
    } catch {
      // Storage can be unavailable in private modes; keep the current theme.
    }
    changed();
  };
  syncState();
  if (root.dataset.theme) syncToolbar();
  document.addEventListener("themechange", changed);
  systemDark.addEventListener("change", changed);
  // A page restored by the Back button, or open in another tab, missed the change.
  addEventListener("pageshow", (event) => {
    if (event.persisted) applyStored();
  });
  addEventListener("storage", (event) => {
    if (event.key === "theme") applyStored();
  });
</script>
