---
import { toIsoInstant, type DeadlineStatus } from "../lib/dates";
import { STATUS_LABELS } from "../lib/view";

interface Props {
  status: DeadlineStatus;
  extended?: boolean;
  /** The deadline's moment, so a page built earlier can correct itself. */
  due?: Date | undefined;
}
const { status, extended = false, due } = Astro.props;
---

<span class="status-group">
  <span class={`status status--${status}`} data-status-due={due && toIsoInstant(due)}>
    {STATUS_LABELS[status]}
  </span>
  {extended && <span class="status status--extended">Extended</span>}
</span>
