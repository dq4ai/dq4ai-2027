---
import { getDeadlines, getKeynotes, getSite } from "../lib/content";
import { formatAoE, formatIsoDay, TBA } from "../lib/dates";
import { url } from "../lib/paths";
import { isKnown, nextDeadline, stripPrefix } from "../lib/view";
import Value from "./Value.astro";

const [site, deadlines, keynotes] = await Promise.all([getSite(), getDeadlines(), getKeynotes()]);
// Only the next deadline: the full list is on the Dates page, one link away.
const next = nextDeadline(deadlines);
const anyDated = deadlines.some((deadline) => deadline.due);
---

<section aria-labelledby="key-facts">
  <h2 id="key-facts" class="visually-hidden">
    Key facts
  </h2>
  <dl class="facts record">
    {next ? (
      <div>
        <dt>{next.label}</dt>
        <dd>
          <span class="visually-hidden next-label">{stripPrefix(next.kind)}</span>
          <time class="flag" datetime={next.due.toISOString()} data-due={next.due.toISOString()}>
            {formatAoE(next.due)}
          </time>
        </dd>
      </div>
    ) : (
      !anyDated && (
        <div>
          <dt>Paper deadlines</dt>
          <dd>
            <Value of={TBA} />
          </dd>
        </div>
      )
    )}
    <div>
      <dt>Workshop date</dt>
      <dd>
        {site.workshopDate === TBA ? (
          <Value of={TBA} />
        ) : (
          <time datetime={site.workshopDate}>{formatIsoDay(site.workshopDate)}</time>
        )}
      </dd>
    </div>
    {keynotes.length > 0 && (
      <div>
        <dt>{keynotes.length === 1 ? "Keynote" : "Keynotes"}</dt>
        <dd>
          {keynotes.map((keynote, index) => (
            <>
              {index > 0 && "; "}
              {isKnown(keynote.person.name) ? (
                <a href={url(`/keynotes/#${keynote.id}`)}>{keynote.person.name}</a>
              ) : (
                <Value of={TBA} />
              )}
              {isKnown(keynote.person.affiliation) && `, ${keynote.person.affiliation}`}
            </>
          ))}
        </dd>
      </div>
    )}
  </dl>
  <p class="record__note">
    {next && "Anywhere on Earth (AoE, UTC−12). "}
    <a href={url("/dates/")}>All dates</a>
  </p>
</section>
