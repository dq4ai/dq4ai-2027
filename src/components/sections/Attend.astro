---
import { getAttend, getSite } from "../../lib/content";
import { hostDatesSentence } from "../../lib/view";
import ContentImage from "../ContentImage.astro";
import ExternalLink from "../ExternalLink.astro";
import PageSection from "../PageSection.astro";
import PhotoCredit from "../PhotoCredit.astro";
import ProseSections from "../ProseSections.astro";

const [site, sections] = await Promise.all([getSite(), getAttend()]);
const photo = site.hostPhoto;
const imageProps = photo && {
  file: photo.file,
  alt: photo.alt,
  widths: [480, 832, 1200, 1664],
  sizes: "(min-width: 80rem) 66rem, 100vw",
  // On a phone the whole panorama would be a sliver; a crop on the belfry side stays a photo.
  phone: { width: 720, height: 480, position: "right", sizes: "calc(100vw - 2rem)" },
};
---

<PageSection id="attend">
  <p>{hostDatesSentence(site)}</p>
  <ProseSections {sections} pendingId="attend-to-come" />
  {photo && imageProps && (
    <div class="subsection">
      <h3 id="host-city">Host city</h3>
      <figure class="city-photo">
        {site.host.cityUrl ? (
          <ExternalLink href={site.host.cityUrl}>
            <ContentImage {...imageProps} />
          </ExternalLink>
        ) : (
          <ContentImage {...imageProps} />
        )}
        <figcaption class="note">
          <PhotoCredit {photo} />
          {site.host.cityUrl && (
            <>
              {" "}
              <ExternalLink href={site.host.cityUrl}>
                About {site.host.city} on Wikipedia, in French
              </ExternalLink>
            </>
          )}
        </figcaption>
      </figure>
    </div>
  )}
</PageSection>
