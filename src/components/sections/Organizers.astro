---
import { getCommittees } from "../../lib/content";
import PageSection from "../PageSection.astro";
import PersonEntry from "../PersonEntry.astro";

const committees = await getCommittees();
// Every committee but the program committee, which has its own section, as on the previous
// edition's site.
const groups = committees.filter(
  (committee) => committee.id !== "program-committee" && committee.people.length > 0,
);
---

<PageSection id="organizers">
  {groups.map((committee) => (
    <div class="subsection">
      <h3 id={committee.id}>{committee.title}</h3>
      {committee.note && <p class="note">{committee.note}</p>}
      <ul class="people">
        {committee.people.map((person) => (
          <li class="person">
            <PersonEntry {person} />
          </li>
        ))}
      </ul>
    </div>
  ))}
</PageSection>
