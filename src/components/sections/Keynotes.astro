---
import { getKeynotes } from "../../lib/content";
import { isKnown } from "../../lib/view";
import ContentImage from "../ContentImage.astro";
import PageSection from "../PageSection.astro";
import PersonEntry from "../PersonEntry.astro";
import Value from "../Value.astro";

const keynotes = await getKeynotes();
---

{keynotes.length > 0 && (
  <PageSection id="keynotes">
    {keynotes.map((keynote) => (
      <article class="keynote">
        <div>
          {keynote.photo && (
            <ContentImage
              file={keynote.photo.file}
              alt={keynote.photo.alt}
              widths={[192, 224, 384, 448]}
              sizes="(min-width: 60rem) 12rem, 14rem"
            />
          )}
          {/* Name and affiliation on one line, as for everyone else on the page. */}
          <h3 id={keynote.id} class="keynote__person">
            {isKnown(keynote.person.name) ? (
              <PersonEntry person={keynote.person} />
            ) : (
              <Value of={keynote.person.name} unknown="Speaker to be announced" />
            )}
          </h3>
        </div>
        {/* Nothing known about the talk yet: one "To be announced", as the organizers asked. */}
        {isKnown(keynote.title) || isKnown(keynote.abstract) || isKnown(keynote.bio) ? (
          <dl class="facts">
            <div>
              <dt>Talk title</dt>
              <dd>
                <Value of={keynote.title} />
              </dd>
            </div>
            <div>
              <dt>Abstract</dt>
              <dd>
                <Value of={keynote.abstract} />
              </dd>
            </div>
            <div>
              <dt>Biography</dt>
              <dd>
                <Value of={keynote.bio} />
              </dd>
            </div>
          </dl>
        ) : (
          <p>
            <Value of={keynote.title} />
          </p>
        )}
      </article>
    ))}
  </PageSection>
)}
