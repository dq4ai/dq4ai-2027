---
import { getPapers } from "../../lib/content";
import ExternalLink from "../ExternalLink.astro";
import PageSection from "../PageSection.astro";

const papers = await getPapers();
const groups = [
  { id: "research", title: "Research papers" },
  { id: "system", title: "System and application papers" },
  { id: "vision", title: "Vision papers" },
].map((group) => ({ ...group, papers: papers.filter((paper) => paper.type === group.id) }));
---

{papers.length > 0 && (
  <PageSection id="accepted-papers">
    {groups
      .filter((group) => group.papers.length > 0)
      .map((group) => (
        <div class="subsection">
          <h3 id={group.id}>{group.title}</h3>
          {group.papers.map((paper) => (
            <article class="entry" id={paper.id}>
              <h4>
                {paper.url ? (
                  <ExternalLink href={paper.url}>{paper.title}</ExternalLink>
                ) : (
                  paper.title
                )}
              </h4>
              <p class="entry__meta">{paper.authors.join(", ")}</p>
              {paper.abstract && (
                <details>
                  <summary>Abstract</summary>
                  <p>{paper.abstract}</p>
                </details>
              )}
            </article>
          ))}
        </div>
      ))}
  </PageSection>
)}
