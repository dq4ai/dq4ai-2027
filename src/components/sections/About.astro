---
import { getCfp, getSite } from "../../lib/content";
import PageSection from "../PageSection.astro";

const [site, cfp] = await Promise.all([getSite(), getCfp()]);
// The whole scope and the goal, read in place: the organizers asked for no "Read more".
---

<PageSection id="about" title={`About the ${site.acronym} Workshop`} class="about">
  {[...cfp.scope, cfp.goal].map((paragraph) => (
    <p>{paragraph}</p>
  ))}
</PageSection>
