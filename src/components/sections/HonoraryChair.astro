---
import { getCommittees } from "../../lib/content";
import PageSection from "../PageSection.astro";
import PersonEntry from "../PersonEntry.astro";

// Its own section before the keynote speakers, not under Organization, as the organizers asked.
const chair = (await getCommittees()).find((committee) => committee.id === "honorary-chair");
---

{chair && chair.people.length > 0 && (
  <PageSection id="honorary-chair">
    <ul class="people honorary-chair">
      {chair.people.map((person) => (
        <li class="person">
          <PersonEntry {person} />
        </li>
      ))}
    </ul>
  </PageSection>
)}
