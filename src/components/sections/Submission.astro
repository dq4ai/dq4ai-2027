---
import { getCfp, getSite, getSubmission } from "../../lib/content";
import { TBA } from "../../lib/dates";
import { isKnown } from "../../lib/view";
import ExternalLink from "../ExternalLink.astro";
import PageSection from "../PageSection.astro";
import PaperTemplate from "../PaperTemplate.astro";
import Dates from "./Dates.astro";
import PaperCategories from "./PaperCategories.astro";

const [site, submission, cfp] = await Promise.all([getSite(), getSubmission(), getCfp()]);
// As on the previous edition's site: what is known is said, and nothing is listed as "to be
// announced". The submission link is a placeholder until site.yaml has the real address, as the
// organizers asked.
const facts = [
  { label: "Review model", value: site.reviewModel },
  { label: "Formatting", value: submission.formatting },
  { label: "Anonymization", value: submission.anonymization },
].filter((fact) => isKnown(fact.value));
---

<PageSection id="submission">
  {/* In the previous edition's order: the categories, then the dates, then how to submit. */}
  <PaperCategories />
  <Dates />
  <div class="subsection">
    <h3 id="submission-details">Submission details</h3>
    <p class="submit-line">
      Authors must format their submissions according to the <PaperTemplate />, and all submissions
      in PDF format should be submitted{" "}
      {site.submissionUrl === TBA ? (
        <>
          <a class="link-pending">here</a>
          <span class="visually-hidden">(link to come)</span>
        </>
      ) : (
        <ExternalLink href={site.submissionUrl}>here</ExternalLink>
      )}
      .
    </p>
    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}
    <p>
      {cfp.proceedingsNote} {cfp.presentation}
    </p>
  </div>
</PageSection>
