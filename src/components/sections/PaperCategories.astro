---
import { getCfp } from "../../lib/content";
import { isKnown } from "../../lib/view";
import Value from "../Value.astro";

const cfp = await getCfp();
// Part of the Submission section, as the organizers asked: the categories, then one sentence on
// the lengths of all of them.
---

<div class="subsection paper-categories">
  <h3 id="paper-categories">Paper categories</h3>
  <p>{cfp.paperTypesIntro}</p>
  {/* One bullet each, the name in bold before its description, as the previous edition listed
      them. Read in place: nothing to open. */}
  <ul class="paper-types">
    {cfp.paperTypes.map((type) => (
      <li id={`paper-${type.id}`}>
        <strong>{type.title}:</strong> {type.description}
      </li>
    ))}
  </ul>
  {isKnown(cfp.paperLengths) ? (
    <p class="paper-lengths">{cfp.paperLengths}</p>
  ) : (
    <dl class="facts page-limits">
      <div>
        <dt>Page limits</dt>
        <dd>
          <Value of={cfp.paperLengths} />
        </dd>
      </div>
    </dl>
  )}
</div>
