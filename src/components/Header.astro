---
import { getKeynotes } from "../lib/content";
import { menuSections } from "../lib/nav";
import { url } from "../lib/paths";
import Wordmark from "./Wordmark.astro";

const keynotes = await getKeynotes();
// Every link but Home is a section of the one page.
const links = [
  { href: url("/"), label: "Home", home: true },
  ...menuSections({ keynotes: keynotes.length > 0 }).map((section) => ({
    href: url(`/#${section.id}`),
    label: section.menu,
    home: false,
  })),
];
---

<header class="site-header">
  <div class="site-header__inner">
    <Wordmark />
    <button
      class="icon-button nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      Menu
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li class={link.home ? "site-nav__home" : undefined}>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // The inline bootstrap in src/lib/theme.ts opens and closes the menu. This adds the ways to leave it.
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("site-nav");
  const isOpen = () => toggle?.getAttribute("aria-expanded") === "true";
  const close = () => {
    if (!toggle) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.textContent = "Menu";
    nav?.removeAttribute("data-open");
  };

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isOpen()) return;
    const focusInMenu = nav?.contains(document.activeElement) || document.activeElement === toggle;
    close();
    if (focusInMenu) toggle?.focus();
  });
  document.addEventListener("click", (event) => {
    if (!isOpen() || !(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>("#site-nav a");
    if (link?.pathname === location.pathname || !event.target.closest(".site-header")) close();
  });
  matchMedia("(width >= 65rem)").addEventListener("change", close);
  // The browser can restore this page from its memory with the menu still open.
  addEventListener("pageshow", (event) => {
    if (event.persisted) close();
  });
</script>
