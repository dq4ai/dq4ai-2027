---
import { getPapers } from "../lib/content";
import { visibleRoutes } from "../lib/nav";
import { url } from "../lib/paths";
import ThemeToggle from "./ThemeToggle.astro";
import Wordmark from "./Wordmark.astro";

const papers = await getPapers();
const routes = visibleRoutes(papers.length > 0).filter(
  (route) => route.primary || route.slug === "home",
);
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <Wordmark />
    <button
      class="icon-button nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      Menu
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {routes.map((route) => {
          const href = url(route.path);
          return (
            <li class={route.slug === "home" ? "site-nav__home" : undefined}>
              <a {href} aria-current={current === href ? "page" : undefined}>
                {route.title}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<script>
  // The inline bootstrap in src/lib/theme.ts opens and closes the menu. This adds the ways to leave it.
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("site-nav");
  const isOpen = () => toggle?.getAttribute("aria-expanded") === "true";
  const close = () => {
    if (!toggle) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.textContent = "Menu";
    nav?.removeAttribute("data-open");
  };

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isOpen()) return;
    const focusInMenu = nav?.contains(document.activeElement) || document.activeElement === toggle;
    close();
    if (focusInMenu) toggle?.focus();
  });
  document.addEventListener("click", (event) => {
    if (!isOpen() || !(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>("#site-nav a");
    if (link?.pathname === location.pathname || !event.target.closest(".site-header")) close();
  });
  matchMedia("(width >= 65rem)").addEventListener("change", close);
  // The browser can restore this page from its memory with the menu still open.
  addEventListener("pageshow", (event) => {
    if (event.persisted) close();
  });
</script>
