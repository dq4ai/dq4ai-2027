---
import { getSite } from "../lib/content";
import { workshopTitle } from "../lib/view";
import Wordmark from "./Wordmark.astro";

const site = await getSite();
// One line, as the previous edition's footer: the workshop's name and nothing to navigate. The
// pages that used to be linked here are reached from the pages that need them.
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <Wordmark />
    <p class="site-footer__title">
      {workshopTitle(site)} ({site.acronym} {site.year})
    </p>
  </div>
</footer>
