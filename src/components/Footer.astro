---
import { getDeadlines, getSite } from "../lib/content";
import { TBA } from "../lib/dates";
import { routeBySlug } from "../lib/nav";
import { url } from "../lib/paths";
import { workshopTitle } from "../lib/view";
import ExternalLink from "./ExternalLink.astro";
import Wordmark from "./Wordmark.astro";

const [site, deadlines] = await Promise.all([getSite(), getDeadlines()]);
const moreLinks = ["policies", "previous-editions"].map(routeBySlug);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <Wordmark />
    </div>
    <div>
      <p>
        {workshopTitle(site)}, co-located with{" "}
        <ExternalLink href={site.host.url}>{site.host.name}</ExternalLink>.
        {site.contactEmail !== TBA && (
          <>
            {" "}
            Contact: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
          </>
        )}
      </p>
      <nav aria-label="More">
        <ul class="site-footer__links">
          {moreLinks.map((route) => (
            <li>
              <a href={url(route.path)}>{route.title}</a>
            </li>
          ))}
          <li>
            <a href={url("/cfp.txt")}>Call for papers as plain text</a>
          </li>
          {deadlines.some((deadline) => deadline.due) && (
            <li>
              <a href={url("/calendar/deadlines.ics")}>Deadlines calendar</a>
            </li>
          )}
          <li>
            <a href={url("/rss.xml")}>News feed</a>
          </li>
        </ul>
      </nav>
      <p class="site-footer__legal">Content under CC BY 4.0. No cookies, no tracking.</p>
    </div>
  </div>
</footer>
