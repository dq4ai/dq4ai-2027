---
interface Props {
  id: string;
  level?: 2 | 3;
}
const { id, level = 2 } = Astro.props;
const Tag = `h${level}` as const;
const label = await Astro.slots.render("default");
const plainLabel = label.replace(/<[^>]*>/g, "").trim();
---

<Tag {id} class="section-heading">
  <Fragment set:html={label} />
  <a class="anchor" href={`#${id}`} aria-label={`Link to section: ${plainLabel}`}>
    #
  </a>
</Tag>
