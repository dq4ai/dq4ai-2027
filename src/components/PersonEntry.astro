---
import type { Person } from "../lib/schemas";
import { isKnown } from "../lib/view";
import ExternalLink from "./ExternalLink.astro";
import Value from "./Value.astro";

interface Props {
  person: Person;
}
const { person } = Astro.props;
// One line, as conference officer lists read: "Name, Affiliation, Country". The name links to the
// person's own page when there is one, otherwise to their DBLP or ORCID profile.
const profile = person.url ?? person.dblp ?? person.orcid;
const place = isKnown(person.affiliation)
  ? [person.affiliation, person.country].filter(Boolean).join(", ")
  : undefined;
---

<span class="person__name">
  {profile ? <ExternalLink href={profile}>{person.name}</ExternalLink> : <Value of={person.name} />}
</span>
, {place ?? <span class="tba">affiliation to be announced</span>}
