---
import type { Site } from "../lib/schemas";
import ExternalLink from "./ExternalLink.astro";

interface Props {
  photo: NonNullable<Site["hostPhoto"]>;
}
const { photo } = Astro.props;
---

{photo.subject}. This shows the host city, not the workshop venue. Photo: {photo.author},{" "}
<ExternalLink href={photo.licenseUrl}>{photo.license}</ExternalLink>, via{" "}
<ExternalLink href={photo.sourceUrl}>{photo.source}</ExternalLink>, resized and cropped.
