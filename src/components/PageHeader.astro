---
import { getSite } from "../lib/content";
import type { Site } from "../lib/schemas";
import { pageContext } from "../lib/view";
import ContentImage from "./ContentImage.astro";

interface Props {
  title: string;
  lede?: string;
  /** Set behind the title, under a scrim that keeps the text readable whatever the photo holds. */
  photo?: Site["hostPhoto"];
}
const { title, lede, photo } = Astro.props;
const site = await getSite();
---

<header class:list={["page-header", { "page-header--photo": photo }]}>
  {
    /* Two framings. A phone gets a 16:9 crop from the right of the photo (for the Grand'Place, the
       belfry and the Vieille Bourse) as a card above a plain header; wider screens get the whole
       photo behind the words. Eager and high priority: on either it is the largest thing on the
       first screen, which is why this page has its own phone budget in lighthouserc.json. */
    photo && (
      <ContentImage
        class="page-header__photo"
        file={photo.file}
        alt={photo.alt}
        widths={[800, 1056, 1600]}
        sizes="(min-width: 70rem) 66rem, 100vw"
        loading="eager"
        fetchpriority="high"
        phone={{ width: 800, height: 450, position: "right", sizes: "calc(100vw - 2rem)" }}
      />
    )
  }
  <div class="page-header__text">
    <p class="page-context">{pageContext(site)}</p>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</header>
