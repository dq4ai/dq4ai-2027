---
import { getDeadlines, getNow } from "../lib/content";
import { formatAoE, formatCountdown, timeUntil } from "../lib/dates";
import { url } from "../lib/paths";
import { nextDeadline } from "../lib/view";

const next = nextDeadline(await getDeadlines());
const now = getNow();
const remaining = next ? timeUntil(next.due, now) : null;
---

{next && (
  <aside class="deadline-strip" aria-label="Next deadline">
    <a href={url("/dates/")}>
      <span>
        <strong>Next deadline:</strong> {next.label}, {formatAoE(next.due)}
      </span>
      <span class="deadline-strip__countdown" data-countdown={next.due.toISOString()}>
        {remaining && formatCountdown(remaining)}
      </span>
    </a>
  </aside>
)}

<script>
  import { formatCountdown, timeUntil } from "../lib/dates";

  const countdown = document.querySelector<HTMLElement>("[data-countdown]");
  const target = countdown?.dataset.countdown;
  if (countdown && target) {
    const update = () => {
      const left = timeUntil(new Date(target), new Date());
      countdown.textContent = left ? formatCountdown(left) : "Deadline passed";
    };
    update();
    setInterval(update, 60_000);
  }
</script>
