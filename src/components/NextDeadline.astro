---
import { getDeadlines, getNow } from "../lib/content";
import { formatAoE, formatCountdown, timeUntil } from "../lib/dates";
import { url } from "../lib/paths";
import { nextDeadline, stripPrefix } from "../lib/view";

const deadlines = await getDeadlines();
const next = nextDeadline(deadlines);
const now = getNow();
const remaining = next ? timeUntil(next.due, now) : null;
// Everything still ahead, so a page built earlier can move on when a deadline closes.
const schedule = deadlines
  .flatMap((deadline) => (deadline.due ? [{ ...deadline, due: deadline.due }] : []))
  .filter((deadline) => deadline.status !== "passed")
  .sort((a, b) => a.due.getTime() - b.due.getTime())
  .map((deadline) => ({
    due: deadline.due.toISOString(),
    label: `${deadline.label}, ${formatAoE(deadline.due)}`,
    prefix: stripPrefix(deadline.kind),
  }));
---

{next && (
  <aside class="deadline-strip" aria-label="Next deadline" data-schedule={JSON.stringify(schedule)}>
    <a href={url("/dates/")}>
      <span>
        <strong data-deadline-prefix>{stripPrefix(next.kind)}</strong>{" "}
        <span data-deadline-label>
          {next.label}, {formatAoE(next.due)}
        </span>
      </span>
      <span class="deadline-strip__countdown" data-countdown={next.due.toISOString()}>
        {remaining && formatCountdown(remaining)}
      </span>
    </a>
  </aside>
)}

<script>
  import { deadlineStatus, formatCountdown, timeUntil } from "../lib/dates";
  import { STATUS_LABELS } from "../lib/view";

  interface Entry {
    due: string;
    label: string;
    prefix: string;
  }

  const strip = document.querySelector<HTMLElement>(".deadline-strip");
  const schedule = JSON.parse(strip?.dataset.schedule ?? "[]") as Entry[];
  const countdown = strip?.querySelector("[data-countdown]");
  const prefix = strip?.querySelector("[data-deadline-prefix]");
  const label = strip?.querySelector("[data-deadline-label]");

  const updateStrip = (current: Entry | undefined, now: Date) => {
    if (!strip) return;
    strip.hidden = !current;
    if (!current || !countdown || !prefix || !label) return;
    prefix.textContent = current.prefix;
    label.textContent = current.label;
    const left = timeUntil(new Date(current.due), now);
    countdown.textContent = left && formatCountdown(left);
  };

  const updateRows = (current: Entry | undefined, now: Date) => {
    for (const status of document.querySelectorAll<HTMLElement>("[data-status-due]")) {
      const value = deadlineStatus({ date: status.dataset.statusDue ?? "" }, now);
      status.className = `status status--${value}`;
      status.textContent = STATUS_LABELS[value];
    }
    for (const time of document.querySelectorAll<HTMLElement>("main time[data-due]")) {
      const isNext = time.dataset.due === current?.due;
      time.classList.toggle("flag", isNext);
      const hidden = time.previousElementSibling;
      if (isNext && !hidden?.classList.contains("next-label")) {
        const moved = document.querySelector("main .next-label");
        if (moved) time.before(moved);
      }
    }
    const nextLabel = document.querySelector("main .next-label");
    if (nextLabel) {
      if (current) nextLabel.textContent = current.prefix;
      else nextLabel.remove();
    }
  };

  const updateOffers = (now: Date) => {
    for (const offer of document.querySelectorAll<HTMLElement>("[data-closes]")) {
      offer.hidden = now > new Date(offer.dataset.closes ?? "");
    }
  };

  const tick = () => {
    const now = new Date();
    const current = schedule.find((entry) => new Date(entry.due) >= now);
    updateStrip(current, now);
    updateRows(current, now);
    updateOffers(now);
    // Just after the next minute begins, so the count never reads a minute more than remains.
    setTimeout(tick, 60_000 - (now.getTime() % 60_000) + 50);
  };
  tick();
</script>
