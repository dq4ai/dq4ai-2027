---
import { getImage, Picture } from "astro:assets";
import { contentImage } from "../lib/images";

interface Props {
  file: string;
  alt: string;
  widths: number[];
  sizes: string;
  /** Eager only for an image that can be the largest thing on the first screen. */
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "auto";
  class?: string;
  /**
   * A different framing for phones: the photo cropped to this shape at build time, from the given
   * side. A wide panorama shown whole on a phone is a sliver; a crop keeps it a photo.
   */
  phone?: { width: number; height: number; position: string; sizes: string };
}
const {
  file,
  alt,
  widths,
  sizes,
  loading = "lazy",
  fetchpriority,
  class: className,
  phone,
} = Astro.props;
const src = await contentImage(file);

const PHONE = "(width < 40rem)";
const formats = ["avif", "webp"] as const;
const framed = phone
  ? {
      phone: await Promise.all(
        formats.map((format) =>
          getImage({
            src,
            format,
            width: phone.width,
            height: phone.height,
            widths: [Math.round(phone.width * 0.6), phone.width],
            fit: "cover",
            position: phone.position,
            quality: 45,
          }),
        ),
      ),
      wide: await Promise.all(formats.map((format) => getImage({ src, format, widths }))),
      fallback: await getImage({
        src,
        format: "jpg",
        width: widths[Math.floor(widths.length / 2)],
      }),
    }
  : undefined;
---

{framed && phone ? (
  <picture>
    {framed.phone.map((image, index) => (
      <source
        media={PHONE}
        type={`image/${formats[index]}`}
        srcset={image.srcSet.attribute}
        sizes={phone.sizes}
      />
    ))}
    {framed.wide.map((image, index) => (
      <source type={`image/${formats[index]}`} srcset={image.srcSet.attribute} {sizes} />
    ))}
    <img
      class={className}
      src={framed.fallback.src}
      {alt}
      width={framed.fallback.attributes.width}
      height={framed.fallback.attributes.height}
      {loading}
      {fetchpriority}
      decoding="async"
    />
  </picture>
) : (
  <Picture
    {src}
    {alt}
    {widths}
    {sizes}
    formats={["avif", "webp"]}
    {loading}
    {fetchpriority}
    class={className}
  />
)}
