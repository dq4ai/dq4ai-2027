---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  file: string;
  alt: string;
  widths: number[];
  sizes: string;
  /** Eager only for an image that can be the largest thing on the first screen. */
  loading?: "lazy" | "eager";
}
const { file, alt, widths, sizes, loading = "lazy" } = Astro.props;

const images = {
  ...import.meta.glob<{ default: ImageMetadata }>("/src/content/images/*.{jpg,jpeg,png,webp,avif}"),
  ...import.meta.glob<{ default: ImageMetadata }>(
    "/tests/fixtures/content-populated/images/*.{jpg,jpeg,png,webp,avif}",
  ),
};
const loader = Object.entries(images).find(([path]) => path.endsWith(`/${file}`))?.[1];
if (!loader) throw new Error(`Image "${file}" is not in the images folder`);
const { default: src } = await loader();
---

<Picture {src} {alt} {widths} {sizes} formats={["avif", "webp"]} {loading} />
