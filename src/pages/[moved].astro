---
import type { GetStaticPaths } from "astro";
import { getProgram, getSite } from "../lib/content";
import { redirects } from "../lib/nav";
import { absoluteUrl, url } from "../lib/paths";
import { contentSecurityPolicy } from "../lib/theme";

// The site used to have a page per section. Their addresses may be in announcements already, so
// each one stays as a stub that sends the browser on to its section of the one page.
export const getStaticPaths = (async () =>
  redirects({ program: (await getProgram()).length > 0 }).map(({ path, to }) => ({
    params: { moved: path.replaceAll("/", "") },
    props: { to },
  }))) satisfies GetStaticPaths;

const { to } = Astro.props;
const site = await getSite();
const target = url(to);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy()} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <title>Moved | {site.acronym} {site.year}</title>
    <link rel="canonical" href={absoluteUrl("/", Astro.site)} />
  </head>
  <body>
    <p>
      This page has moved to <a href={target}>a section of the home page</a>.
    </p>
  </body>
</html>
