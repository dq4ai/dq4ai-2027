---
import LocalTimeToggle from "../components/LocalTimeToggle.astro";
import PageHeader from "../components/PageHeader.astro";
import StatusBadge from "../components/StatusBadge.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDeadlines, getSite } from "../lib/content";
import { formatAoE, formatDayRange, formatIsoDay, TBA } from "../lib/dates";
import { url } from "../lib/paths";

const [site, deadlines] = await Promise.all([getSite(), getDeadlines()]);
// Status adds nothing until a deadline has a date: the date cell already says "To be announced".
const showStatus = deadlines.some((deadline) => deadline.status !== "tba");
---

<BaseLayout slug="dates">
  <PageHeader
    title="Important dates"
    lede="All deadlines are Anywhere on Earth (AoE, UTC−12): a deadline is open until that day has ended everywhere on Earth."
  />
  <div class="toolbar">
    <a class="button" href={url("/calendar/deadlines.ics")} download>
      Add to calendar (.ics)
    </a>
    <LocalTimeToggle />
  </div>
  <p class="note" data-zone-note>
    Times shown in AoE.
  </p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Milestone</th>
          <th scope="col">Date</th>
          {showStatus && <th scope="col">Status</th>}
        </tr>
      </thead>
      <tbody>
        {deadlines.map((deadline) => (
          <tr>
            <th scope="row">{deadline.label}</th>
            <td class="tabular">
              {deadline.previous && (
                <span class="date-change">
                  Was{" "}
                  <del>
                    <time
                      datetime={deadline.previous.toISOString()}
                      data-convert={deadline.previous.toISOString()}
                    >
                      {formatAoE(deadline.previous)}
                    </time>
                  </del>
                </span>
              )}
              {deadline.previous && "Now "}
              {deadline.due ? (
                <time
                  datetime={deadline.due.toISOString()}
                  data-convert={deadline.due.toISOString()}
                >
                  {formatAoE(deadline.due)}
                </time>
              ) : (
                <span class="tba">To be announced</span>
              )}
            </td>
            {showStatus && (
              <td>
                {deadline.status !== "tba" && (
                  <StatusBadge
                    status={deadline.status}
                    extended={deadline.previous !== undefined}
                  />
                )}
              </td>
            )}
          </tr>
        ))}
        <tr>
          <th scope="row">Workshop</th>
          <td class="tabular">
            {site.workshopDate === TBA ? (
              <span class="tba">To be announced</span>
            ) : (
              <time datetime={site.workshopDate}>{formatIsoDay(site.workshopDate)}</time>
            )}
          </td>
          {showStatus && <td></td>}
        </tr>
        <tr>
          <th scope="row">{site.host.name}</th>
          <td class="tabular">{formatDayRange(site.host.startDate, site.host.endDate)}</td>
          {showStatus && <td></td>}
        </tr>
      </tbody>
    </table>
  </div>
</BaseLayout>
