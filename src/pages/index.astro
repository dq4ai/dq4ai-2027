---
import ContentImage from "../components/ContentImage.astro";
import ExternalLink from "../components/ExternalLink.astro";
import HeroWaves from "../components/HeroWaves.astro";
import Heading from "../components/Heading.astro";
import Mark from "../components/Mark.astro";
import TopicList from "../components/TopicList.astro";
import WorkshopRecord from "../components/WorkshopRecord.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCfp, getCommittees, getDeadlines, getNews, getSite, getSponsors } from "../lib/content";
import { formatHeadlineDay, formatIsoDay, TBA } from "../lib/dates";
import { absoluteUrl, url } from "../lib/paths";
import { buildEventJsonLd, serializeJsonLd } from "../lib/seo";
import { hostLocation, submissionCloses, submissionOpen, titleLead } from "../lib/view";

const [site, cfp, committees, deadlines, news, sponsors] = await Promise.all([
  getSite(),
  getCfp(),
  getCommittees(),
  getDeadlines(),
  getNews(),
  getSponsors(),
]);
const [dataForAi, aiForData] = cfp.exchange;
// As the previous edition did: the whole scope and every topic are read here, without a click.
const latest = news.at(0);
const organizers = committees.find((committee) => committee.id === "chairs")?.people ?? [];
const jsonLd = serializeJsonLd(
  buildEventJsonLd({ site, url: absoluteUrl("/", Astro.site), organizers }),
);
---

<BaseLayout slug="home">
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLd} />
  <div class="hero">
    <div class="hero__banner">
      <HeroWaves />
      <div class="hero__title">
        <Mark class="hero__mark" />
        {/* One line each, as the previous edition's banner set them. */}
        <h1>
          <span class="hero__lead">{titleLead(site)}</span>
          <span class="hero__name">
            {site.title} ({site.acronym} {site.year}),
          </span>
        </h1>
        <p class="hero__where">
          co-located with <ExternalLink href={site.host.url}>{site.host.name}</ExternalLink>,{" "}
          {hostLocation(site)}
        </p>
        {site.workshopDate !== TBA && (
          <p class="hero__date">
            (<time datetime={site.workshopDate}>{formatHeadlineDay(site.workshopDate)}</time>)
          </p>
        )}
      </div>
    </div>
    <div class="hero__body">
      <div>
        <p class="exchange">
          <span>{dataForAi}</span> <span>{aiForData}</span>
        </p>
        {site.statusNote && <p class="note status-note">{site.statusNote}</p>}
        <div class="hero__actions">
          {submissionOpen(site, deadlines) ? (
            <>
              <ExternalLink
                class="button button--primary"
                href={site.submissionUrl}
                data-closes={submissionCloses(deadlines)}
              >
                Submit a paper
              </ExternalLink>
              <a class="hero__link" href={url("/call-for-papers/")}>
                Read the call for papers
              </a>
            </>
          ) : (
            <a class="button button--primary" href={url("/call-for-papers/")}>
              Read the call for papers
            </a>
          )}
        </div>
      </div>
      <WorkshopRecord />
    </div>
  </div>

  <section class="about">
    <Heading id="about">About the {site.acronym} Workshop</Heading>
    {[...cfp.scope, cfp.goal].map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </section>

  <section>
    <Heading id="topics">Topics of interest</Heading>
    <p>{cfp.topicsIntro}</p>
    <TopicList topics={cfp.topics} />
  </section>

  {latest && (
    <p class="news-line">
      <span class="news-line__label">Latest news</span>{" "}
      <a href={url(`/news/#news-${latest.id}`)}>{latest.data.title}</a>,{" "}
      <time datetime={latest.data.date}>{formatIsoDay(latest.data.date)}</time>
    </p>
  )}

  {sponsors.length > 0 && (
    <section>
      <Heading id="sponsors">Supported by</Heading>
      <ul class="sponsors">
        {sponsors.map((sponsor) => (
          <li>
            <ExternalLink href={sponsor.url}>
              <ContentImage
                file={sponsor.logo.file}
                alt={sponsor.logo.alt}
                widths={[120, 240]}
                sizes="120px"
              />
            </ExternalLink>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
