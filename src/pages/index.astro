---
import ContentImage from "../components/ContentImage.astro";
import ExternalLink from "../components/ExternalLink.astro";
import Mark from "../components/Mark.astro";
import PageSection from "../components/PageSection.astro";
import About from "../components/sections/About.astro";
import Keynotes from "../components/sections/Keynotes.astro";
import Organizers from "../components/sections/Organizers.astro";
import Program from "../components/sections/Program.astro";
import ProgramCommittee from "../components/sections/ProgramCommittee.astro";
import Submission from "../components/sections/Submission.astro";
import Topics from "../components/sections/Topics.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCommittees, getSite, getSponsors } from "../lib/content";
import { formatHeadlineDay, TBA } from "../lib/dates";
import { absoluteUrl } from "../lib/paths";
import { buildEventJsonLd, serializeJsonLd } from "../lib/seo";
import { hostLocation, isKnown, workshopTitle } from "../lib/view";

const [site, committees, sponsors] = await Promise.all([getSite(), getCommittees(), getSponsors()]);
// The whole site is this one page, laid out as the previous edition's (QuaLLM-KG 2026) with this
// edition's content, as the organizers asked: the banner, then each section in the order of
// lib/nav.ts, each ending in a link back to the top.
const organizers = committees.find((committee) => committee.id === "chairs")?.people ?? [];
// The banner photo's licence (CC BY-SA 4.0) requires this credit on the page.
const photoLicense = "https://creativecommons.org/licenses/by-sa/4.0/";
const photoSource = "https://commons.wikimedia.org/wiki/File:Lille_gd_place_pano_ter.jpg";
const jsonLd = serializeJsonLd(
  buildEventJsonLd({ site, url: absoluteUrl("/", Astro.site), organizers }),
);
---

<BaseLayout slug="home">
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLd} />
  <div class="hero">
    <div class="hero__banner">
      <ContentImage
        class="hero__photo"
        file="lille-grand-place-dusk.jpg"
        alt=""
        widths={[640, 960, 1440, 1800]}
        sizes="(min-width: 60rem) 56rem, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={40}
      />
      <div class="hero__title">
        <Mark class="hero__mark" />
        {/* As the previous edition's banner: the short name large, the full title smaller below. */}
        <h1>
          {site.acronym} {site.year}
        </h1>
        <p class="hero__name">{workshopTitle(site)}</p>
        <p class="hero__where">
          co-located with <ExternalLink href={site.host.url}>{site.host.name}</ExternalLink>,{" "}
          {hostLocation(site)}
        </p>
        {site.workshopDate !== TBA && (
          <p class="hero__date">
            (<time datetime={site.workshopDate}>{formatHeadlineDay(site.workshopDate)}</time>)
          </p>
        )}
      </div>
      {/* Shown at the foot of the photo on hover, keyboard focus or, on a touch screen, a tap. */}
      <p class="hero__credit">
        The Grand'Place, Lille. Photo: Velvet,{" "}
        <ExternalLink href={photoLicense}>CC BY-SA 4.0</ExternalLink>, via{" "}
        <ExternalLink href={photoSource}>Wikimedia Commons</ExternalLink>, cropped.
      </p>
    </div>
  </div>
  {site.statusNote && <p class="note status-note">{site.statusNote}</p>}
  <script>
    // A touch screen has no hover: a tap on the banner shows the photo's credit, another hides it.
    // Links in the banner keep working as links.
    const banner = document.querySelector<HTMLElement>(".hero__banner");
    if (banner && matchMedia("(hover: none)").matches) {
      banner.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) return;
        banner.toggleAttribute("data-credit");
      });
    }
  </script>

  <About />
  <Topics />
  <Submission />
  <Program />
  <Keynotes />
  <Organizers />
  <ProgramCommittee />

  {sponsors.length > 0 && (
    <PageSection id="sponsors">
      <ul class="sponsors">
        {sponsors.map((sponsor) => (
          <li>
            <ExternalLink href={sponsor.url}>
              <ContentImage
                file={sponsor.logo.file}
                alt={sponsor.logo.alt}
                widths={[120, 240]}
                sizes="120px"
              />
            </ExternalLink>
          </li>
        ))}
      </ul>
    </PageSection>
  )}
  {/* At the end of the page, as the organizers asked. */}
  {isKnown(site.contactEmail) && (
    <p class="contact">
      Contact: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </p>
  )}
</BaseLayout>
