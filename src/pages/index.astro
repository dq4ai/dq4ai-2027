---
import ContactSection from "../components/ContactSection.astro";
import ContentImage from "../components/ContentImage.astro";
import ExternalLink from "../components/ExternalLink.astro";
import HeroWaves from "../components/HeroWaves.astro";
import Mark from "../components/Mark.astro";
import PageSection from "../components/PageSection.astro";
import About from "../components/sections/About.astro";
import AcceptedPapers from "../components/sections/AcceptedPapers.astro";
import Attend from "../components/sections/Attend.astro";
import Dates from "../components/sections/Dates.astro";
import Keynotes from "../components/sections/Keynotes.astro";
import News from "../components/sections/News.astro";
import Organization from "../components/sections/Organization.astro";
import PaperCategories from "../components/sections/PaperCategories.astro";
import Policies from "../components/sections/Policies.astro";
import PreviousEditions from "../components/sections/PreviousEditions.astro";
import Program from "../components/sections/Program.astro";
import Submission from "../components/sections/Submission.astro";
import Topics from "../components/sections/Topics.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCommittees, getSite, getSponsors } from "../lib/content";
import { formatHeadlineDay, TBA } from "../lib/dates";
import { absoluteUrl } from "../lib/paths";
import { buildEventJsonLd, serializeJsonLd } from "../lib/seo";
import { hostLocation, titleLead } from "../lib/view";

const [site, committees, sponsors] = await Promise.all([getSite(), getCommittees(), getSponsors()]);
// The whole site is this one page, as the organizers asked: the banner, then each section in the
// order of lib/nav.ts, each ending in a link back to the top. Nothing sits between the banner and
// About, as they asked before.
const organizers = committees.find((committee) => committee.id === "chairs")?.people ?? [];
const jsonLd = serializeJsonLd(
  buildEventJsonLd({ site, url: absoluteUrl("/", Astro.site), organizers }),
);
---

<BaseLayout slug="home">
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLd} />
  <div class="hero">
    <div class="hero__banner">
      <HeroWaves />
      <div class="hero__title">
        <Mark class="hero__mark" />
        {/* One line each, as the previous edition's banner set them. */}
        <h1>
          <span class="hero__lead">{titleLead(site)}</span>
          <span class="hero__name">
            {site.title} ({site.acronym} {site.year}),
          </span>
        </h1>
        <p class="hero__where">
          co-located with <ExternalLink href={site.host.url}>{site.host.name}</ExternalLink>,{" "}
          {hostLocation(site)}
        </p>
        {site.workshopDate !== TBA && (
          <p class="hero__date">
            (<time datetime={site.workshopDate}>{formatHeadlineDay(site.workshopDate)}</time>)
          </p>
        )}
      </div>
    </div>
  </div>
  {site.statusNote && <p class="note status-note">{site.statusNote}</p>}

  <About />
  <Topics />
  <PaperCategories />
  <Dates />
  <Submission />
  <Policies />
  <Program />
  <Keynotes />
  <AcceptedPapers />
  <Organization />
  <Attend />
  <ContactSection />
  <News />
  <PreviousEditions />

  {sponsors.length > 0 && (
    <PageSection id="sponsors">
      <ul class="sponsors">
        {sponsors.map((sponsor) => (
          <li>
            <ExternalLink href={sponsor.url}>
              <ContentImage
                file={sponsor.logo.file}
                alt={sponsor.logo.alt}
                widths={[120, 240]}
                sizes="120px"
              />
            </ExternalLink>
          </li>
        ))}
      </ul>
    </PageSection>
  )}
</BaseLayout>
