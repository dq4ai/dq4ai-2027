---
import ContentImage from "../components/ContentImage.astro";
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import Mark from "../components/Mark.astro";
import TopicIcon from "../components/TopicIcon.astro";
import Value from "../components/Value.astro";
import WorkshopRecord from "../components/WorkshopRecord.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getCfp,
  getCommittees,
  getDeadlines,
  getKeynotes,
  getNews,
  getSite,
  getSponsors,
} from "../lib/content";
import { formatIsoDay, TBA } from "../lib/dates";
import { absoluteUrl, url } from "../lib/paths";
import { buildEventJsonLd, serializeJsonLd } from "../lib/seo";
import { isKnown, siteSummary, submissionCloses, submissionOpen, topicAnchor } from "../lib/view";

const [site, cfp, committees, deadlines, keynotes, news, sponsors] = await Promise.all([
  getSite(),
  getCfp(),
  getCommittees(),
  getDeadlines(),
  getKeynotes(),
  getNews(),
  getSponsors(),
]);
// The first scope paragraph says why quality matters; the last states the two-way relationship
// and opens by referring back to the first, so they stay together.
const why = cfp.scope.at(0);
const relationship = cfp.scope.at(-1);
const [dataForAi, aiForData] = cfp.exchange;
const organizers = committees.find((committee) => committee.id === "chairs")?.people ?? [];
const jsonLd = serializeJsonLd(
  buildEventJsonLd({ site, url: absoluteUrl("/", Astro.site), organizers }),
);
---

<BaseLayout slug="home">
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLd} />
  <div class="hero">
    <div class="hero__title">
      <Mark class="hero__mark" />
      <h1>{site.title}</h1>
    </div>
    <div class="hero__body">
      <div>
        <p class="lede">{siteSummary(site)}</p>
        {site.statusNote && <p class="note status-note">{site.statusNote}</p>}
        <div class="hero__actions">
          {!submissionOpen(site, deadlines) ? (
            <>
              <a class="button button--primary" href={url("/call-for-papers/")}>
                Read the call for papers
              </a>
              <a class="button" href={url("/submission/")}>
                Submission details
              </a>
            </>
          ) : (
            <>
              <ExternalLink
                class="button button--primary"
                href={site.submissionUrl}
                data-closes={submissionCloses(deadlines)}
              >
                Submit a paper
              </ExternalLink>
              <a class="button" href={url("/call-for-papers/")}>
                Read the call for papers
              </a>
            </>
          )}
        </div>
      </div>
      <WorkshopRecord />
    </div>
  </div>

  <section class="topic-band">
    <Heading id="topics">Topics of interest</Heading>
    <ul class="topic-grid">
      {cfp.topics.map((topic) => (
        <li>
          <a href={url(`/call-for-papers/#${topicAnchor(topic.title)}`)}>
            {topic.icon && <TopicIcon name={topic.icon} />}
            <span>{topic.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="more-link">
      <a href={url("/call-for-papers/")}>Read the full call for papers</a>
    </p>
  </section>

  <section class="purpose">
    <Heading id="about">Why data quality for AI</Heading>
    <p class="exchange">
      <span>
        <TopicIcon name="data-quality" />
        {dataForAi}
      </span>{" "}
      <span>
        <TopicIcon name="ai-for-quality" />
        {aiForData}
      </span>
    </p>
    <p>{why}</p>
    <p>{relationship}</p>
    <p>{cfp.goal}</p>
  </section>

  {keynotes.length > 0 && (
    <section>
      <Heading id="keynote">{keynotes.length === 1 ? "Keynote" : "Keynotes"}</Heading>
      {keynotes.map((keynote) => (
        <div class="entry">
          <h3>
            <Value of={keynote.person.name} unknown="Speaker to be announced" />
          </h3>
          {isKnown(keynote.person.name) && (
            <p class="entry__meta">
              <Value of={keynote.person.affiliation} />
            </p>
          )}
          <p>
            <a href={url(`/keynotes/#${keynote.id}`)}>
              {keynote.title === TBA ? (
                <>
                  Keynote details
                  <span class="visually-hidden">
                    :{" "}
                    {isKnown(keynote.person.name) ? keynote.person.name : "speaker to be announced"}
                  </span>
                </>
              ) : (
                keynote.title
              )}
            </a>
          </p>
        </div>
      ))}
    </section>
  )}

  <section>
    <Heading id="related-venues">How DQ4AI relates to other venues</Heading>
    <p>{cfp.relatedVenues.distinction}</p>
  </section>

  {news.length > 0 && (
    <section>
      <Heading id="latest-news">Latest news</Heading>
      {news.slice(0, 3).map((item) => (
        <div class="entry">
          <p class="entry__meta">
            <time datetime={item.data.date}>{formatIsoDay(item.data.date)}</time>
          </p>
          <h3>
            <a href={url(`/news/#news-${item.id}`)}>{item.data.title}</a>
          </h3>
          <p>{item.data.summary}</p>
        </div>
      ))}
    </section>
  )}

  {sponsors.length > 0 && (
    <section>
      <Heading id="sponsors">Supported by</Heading>
      <ul class="sponsors">
        {sponsors.map((sponsor) => (
          <li>
            <ExternalLink href={sponsor.url}>
              <ContentImage
                file={sponsor.logo.file}
                alt={sponsor.logo.alt}
                widths={[120, 240]}
                sizes="120px"
              />
            </ExternalLink>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
