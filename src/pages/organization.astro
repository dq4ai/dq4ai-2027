---
import ContactSection from "../components/ContactSection.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import PersonEntry from "../components/PersonEntry.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCommittees } from "../lib/content";

const committees = await getCommittees();
---

<BaseLayout slug="organization">
  <PageHeader title="Organization" />
  {committees
    .filter((committee) => committee.people.length > 0)
    .map((committee) => (
      <section>
        <Heading id={committee.id}>{committee.title}</Heading>
        {committee.note && <p class="note">{committee.note}</p>}
        <ul class="people">
          {committee.people.map((person) => (
            <li class="person">
              <PersonEntry {person} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  <ContactSection label="Questions or corrections" />
</BaseLayout>
