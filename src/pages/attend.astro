---
import ContactSection from "../components/ContactSection.astro";
import ContentImage from "../components/ContentImage.astro";
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoCredit from "../components/PhotoCredit.astro";
import ProseSections from "../components/ProseSections.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAttend, getSite } from "../lib/content";
import { hostDatesSentence } from "../lib/view";

const [site, sections] = await Promise.all([getSite(), getAttend()]);
const photo = site.hostPhoto;
const imageProps = photo && {
  file: photo.file,
  alt: photo.alt,
  widths: [480, 832, 1200, 1664],
  sizes: "(min-width: 70rem) 52rem, 100vw",
  loading: "eager" as const,
};
---

<BaseLayout slug="attend">
  <PageHeader title="Attend" lede={hostDatesSentence(site)} />
  <ProseSections {sections} />
  <ContactSection label="Questions about attending" />
  {photo && imageProps && (
    <section>
      <Heading id="host-city">Host city</Heading>
      <figure class="city-photo">
        {site.host.cityUrl ? (
          <ExternalLink href={site.host.cityUrl}>
            <ContentImage {...imageProps} />
          </ExternalLink>
        ) : (
          <ContentImage {...imageProps} />
        )}
        <figcaption class="note">
          <PhotoCredit {photo} />
          {site.host.cityUrl && (
            <>
              {" "}
              <ExternalLink href={site.host.cityUrl}>
                About {site.host.city} on Wikipedia, in French
              </ExternalLink>
            </>
          )}
        </figcaption>
      </figure>
    </section>
  )}
</BaseLayout>
