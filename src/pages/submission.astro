---
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import Value from "../components/Value.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCfp, getSite, getSubmission } from "../lib/content";
import { TBA } from "../lib/dates";
import { url } from "../lib/paths";

const [site, submission, cfp] = await Promise.all([getSite(), getSubmission(), getCfp()]);
const pageLimitsUnknown = cfp.paperTypes.every((type) => type.pageLimit === TBA);
---

<BaseLayout slug="submission">
  <PageHeader
    title="Submission"
    lede="What to check before you submit a paper, and where to send it."
  />
  {site.submissionUrl === TBA ? (
    <p>
      <strong>The submission link will be announced here.</strong> See the{" "}
      <a href={url("/dates/")}>important dates</a>.
    </p>
  ) : (
    <p>
      <ExternalLink class="button button--primary" href={site.submissionUrl}>
        Submit a paper
      </ExternalLink>
    </p>
  )}

  <section>
    <Heading id="checklist">Checklist</Heading>
    <ol class="steps">
      {submission.steps.map((step) => (
        <li>
          <strong>{step.title}</strong> {step.detail}
        </li>
      ))}
    </ol>
  </section>

  <section>
    <Heading id="details">Submission details</Heading>
    <dl class="facts">
      <div>
        <dt>Submission system</dt>
        <dd>
          {site.submissionUrl === TBA ? (
            <Value of={site.submissionSystem} />
          ) : (
            <ExternalLink href={site.submissionUrl}>
              {site.submissionSystem === TBA ? site.submissionUrl : site.submissionSystem}
            </ExternalLink>
          )}
        </dd>
      </div>
      {pageLimitsUnknown ? (
        <div>
          <dt>Page limits</dt>
          <dd>
            <Value of={TBA} />
          </dd>
        </div>
      ) : (
        cfp.paperTypes.map((type) => (
          <div>
            <dt>Page limit: {type.title}</dt>
            <dd>
              <Value of={type.pageLimit} />
            </dd>
          </div>
        ))
      )}
      <div>
        <dt>Template</dt>
        <dd>
          <Value of={site.paperTemplate} />
        </dd>
      </div>
      <div>
        <dt>Review model</dt>
        <dd>
          <Value of={site.reviewModel} />
        </dd>
      </div>
      <div>
        <dt>Formatting</dt>
        <dd>
          <Value of={submission.formatting} />
        </dd>
      </div>
      <div>
        <dt>Anonymization</dt>
        <dd>
          <Value of={submission.anonymization} />
        </dd>
      </div>
    </dl>
  </section>

  <section>
    <Heading id="faq">Frequently asked questions</Heading>
    {submission.faq.map((item) => (
      <div class="entry">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
</BaseLayout>
