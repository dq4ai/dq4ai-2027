---
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import PaperTemplate from "../components/PaperTemplate.astro";
import Value from "../components/Value.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCfp, getDeadlines, getSite, getSubmission } from "../lib/content";
import { TBA } from "../lib/dates";
import { url } from "../lib/paths";
import { pageLimitsUnknown, submissionCloses, submissionOpen } from "../lib/view";

const [site, submission, cfp, deadlines] = await Promise.all([
  getSite(),
  getSubmission(),
  getCfp(),
  getDeadlines(),
]);
const limitsUnknown = pageLimitsUnknown(cfp);
---

<BaseLayout slug="submission">
  <PageHeader
    title="Submission"
    lede="What to check before you submit a paper, and where to send it."
  />
  {site.statusNote && <p class="note status-note">{site.statusNote}</p>}
  {site.submissionUrl === TBA ? (
    <p>
      <strong>The submission link will be announced here.</strong> See the{" "}
      <a href={url("/dates/")}>important dates</a>
      {site.host.workshopsUrl && (
        <>
          {" "}
          and the{" "}
          <ExternalLink href={site.host.workshopsUrl}>{site.host.name} workshops page</ExternalLink>
        </>
      )}
      .
    </p>
  ) : submissionOpen(site, deadlines) ? (
    <p class="page-action">
      <ExternalLink
        class="button button--primary"
        href={site.submissionUrl}
        data-closes={submissionCloses(deadlines)}
      >
        Submit a paper
      </ExternalLink>
    </p>
  ) : (
    <p>
      <strong>Submission has closed.</strong> See the <a href={url("/dates/")}>important dates</a>.
    </p>
  )}

  <section>
    <Heading id="checklist">Checklist</Heading>
    <ol class="steps">
      {submission.steps.map((step) => (
        <li>
          <strong>{step.title}</strong> {step.detail}{" "}
          {step.link && <a href={url(step.link.path)}>{step.link.label}</a>}
        </li>
      ))}
    </ol>
  </section>

  <section>
    <Heading id="details">Submission details</Heading>
    <dl class="facts">
      <div>
        <dt>Submission system</dt>
        <dd>
          {site.submissionUrl === TBA ? (
            <Value of={site.submissionSystem} />
          ) : (
            <ExternalLink
              href={site.submissionUrl}
              class={site.submissionSystem === TBA ? "link-is-address" : undefined}
            >
              {site.submissionSystem === TBA ? site.submissionUrl : site.submissionSystem}
            </ExternalLink>
          )}
        </dd>
      </div>
      {limitsUnknown ? (
        <div>
          <dt>Page limits</dt>
          <dd>
            <Value of={TBA} />
          </dd>
        </div>
      ) : (
        cfp.paperTypes.map((type) => (
          <div>
            <dt>Page limit: {type.title}</dt>
            <dd>
              <Value of={type.pageLimit} />
            </dd>
          </div>
        ))
      )}
      <div>
        <dt>Template</dt>
        <dd>
          <PaperTemplate />
        </dd>
      </div>
      <div>
        <dt>Review model</dt>
        <dd>
          <Value of={site.reviewModel} />
        </dd>
      </div>
      <div>
        <dt>Formatting</dt>
        <dd>
          <Value of={submission.formatting} />
        </dd>
      </div>
      <div>
        <dt>Anonymization</dt>
        <dd>
          <Value of={submission.anonymization} />
        </dd>
      </div>
    </dl>
  </section>

  <section>
    <Heading id="faq">Frequently asked questions</Heading>
    {submission.faq.map((item) => (
      <div class="entry">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
</BaseLayout>
