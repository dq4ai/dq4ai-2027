---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/paths";
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <div class="not-found">
    <p class="note">Error 404</p>
    <h1>This page has no matching record.</h1>
    <p class="lede">The address may be mistyped, or the page may have moved.</p>
    <div class="hero__actions">
      <a class="button button--primary" href={url("/")}>
        Go to the home page
      </a>
      <a class="button" href={url("/call-for-papers/")}>
        Read the call for papers
      </a>
    </div>
  </div>
</BaseLayout>
