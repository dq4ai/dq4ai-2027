---
import { render } from "astro:content";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNews } from "../../lib/content";
import { formatIsoDay } from "../../lib/dates";
import { url } from "../../lib/paths";

const news = await getNews();
const items = await Promise.all(
  news.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout slug="news">
  <PageHeader title="News" />
  <p class="note">
    <a href={url("/rss.xml")}>News feed</a>
  </p>
  {items.map(({ entry, Content }) => (
    <article class="entry" id={`news-${entry.id}`}>
      <p class="entry__meta">
        <time datetime={entry.data.date}>{formatIsoDay(entry.data.date)}</time>
      </p>
      <h2>{entry.data.title}</h2>
      <Content />
    </article>
  ))}
</BaseLayout>
