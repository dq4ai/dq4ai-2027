---
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import Value from "../components/Value.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPapers } from "../lib/content";
import { TBA } from "../lib/dates";

const papers = await getPapers();
const groups = [
  { id: "research", title: "Research papers" },
  { id: "system", title: "System and application papers" },
  { id: "vision", title: "Vision papers" },
].map((group) => ({ ...group, papers: papers.filter((paper) => paper.type === group.id) }));
---

<BaseLayout slug="accepted-papers" noindex={papers.length === 0}>
  <PageHeader title="Accepted Papers" />
  {papers.length === 0 && (
    <section>
      <Heading id="papers">Papers</Heading>
      <dl class="facts">
        <div>
          <dt>Accepted papers</dt>
          <dd>
            <Value of={TBA} unknown="Listed after notification" />
          </dd>
        </div>
      </dl>
    </section>
  )}
  {groups
    .filter((group) => group.papers.length > 0)
    .map((group) => (
      <section>
        <Heading id={group.id}>{group.title}</Heading>
        {group.papers.map((paper) => (
          <article class="entry" id={paper.id}>
            <h3>
              {paper.url ? (
                <ExternalLink href={paper.url}>{paper.title}</ExternalLink>
              ) : (
                paper.title
              )}
            </h3>
            <p class="entry__meta">{paper.authors.join(", ")}</p>
            {paper.abstract && (
              <details>
                <summary>Abstract</summary>
                <p>{paper.abstract}</p>
              </details>
            )}
          </article>
        ))}
      </section>
    ))}
</BaseLayout>
