---
import ContentImage from "../components/ContentImage.astro";
import PageHeader from "../components/PageHeader.astro";
import Value from "../components/Value.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getKeynotes } from "../lib/content";

const keynotes = await getKeynotes();
---

<BaseLayout slug="keynotes">
  <PageHeader title="Keynotes" />
  {keynotes.map((keynote) => (
    <article class="keynote">
      <div>
        {keynote.photo && (
          <ContentImage
            file={keynote.photo.file}
            alt={keynote.photo.alt}
            widths={[192, 224, 384, 448]}
            sizes="(min-width: 60rem) 12rem, 14rem"
          />
        )}
        <h2 id={keynote.id}>
          <Value of={keynote.person.name} />
        </h2>
        <p class="entry__meta">
          <Value of={keynote.person.affiliation} />
        </p>
      </div>
      <dl class="facts">
        <div>
          <dt>Talk title</dt>
          <dd>
            <Value of={keynote.title} />
          </dd>
        </div>
        <div>
          <dt>Abstract</dt>
          <dd>
            <Value of={keynote.abstract} />
          </dd>
        </div>
        <div>
          <dt>Biography</dt>
          <dd>
            <Value of={keynote.bio} />
          </dd>
        </div>
      </dl>
    </article>
  ))}
</BaseLayout>
