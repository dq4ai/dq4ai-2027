---
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import Value from "../components/Value.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEditions } from "../lib/content";
import { TBA } from "../lib/dates";

const editions = await getEditions();
---

<BaseLayout slug="previous-editions">
  <PageHeader title="Editions of the workshop" />
  <section>
    <Heading id="editions">Editions</Heading>
    <section class="table-wrap" tabindex="0" aria-label="Editions of the workshop">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Edition</th>
            <th scope="col">Year</th>
            <th scope="col">Co-located with</th>
            <th scope="col">Location</th>
          </tr>
        </thead>
        <tbody>
          {editions.map((edition) => (
            <tr>
              <th scope="row">
                {edition.url === TBA ? (
                  edition.edition
                ) : (
                  <ExternalLink href={edition.url}>{edition.edition}</ExternalLink>
                )}
                {edition.current && <span class="note"> (this edition)</span>}
              </th>
              <td class="tabular">
                <Value of={edition.year} />
              </td>
              <td>
                <Value of={edition.host} />
              </td>
              <td>
                <Value of={edition.city} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </section>
</BaseLayout>
