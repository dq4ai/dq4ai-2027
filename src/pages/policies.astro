---
import PageHeader from "../components/PageHeader.astro";
import ProseSections from "../components/ProseSections.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPolicies } from "../lib/content";
import { url } from "../lib/paths";

const sections = await getPolicies();
---

<BaseLayout slug="policies">
  <PageHeader title="Policies" />
  <p class="note">
    Rules on dual submission and generative AI are in the{" "}
    <a href={url("/call-for-papers/#policies")}>Call for Papers</a>.
  </p>
  <ProseSections {sections} />
</BaseLayout>
