---
import DeadlineRows from "../components/DeadlineRows.astro";
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import PaperTemplate from "../components/PaperTemplate.astro";
import Value from "../components/Value.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCfp, getDeadlines, getSite } from "../lib/content";
import { formatIsoDay, TBA } from "../lib/dates";
import { url } from "../lib/paths";
import { hostDatesSentence, pageLimitsUnknown, topicAnchor, workshopTitle } from "../lib/view";

const [site, cfp, deadlines] = await Promise.all([getSite(), getCfp(), getDeadlines()]);
const limitsUnknown = pageLimitsUnknown(cfp);
---

<BaseLayout slug="call-for-papers">
  <PageHeader
    title="Call for Papers"
    photo={site.cfpPhoto}
    lede={`${workshopTitle(site)} (${site.acronym} ${site.year}), co-located with ${site.host.name}. ${hostDatesSentence(site)}`}
  />
  <section>
    <Heading id="important-dates">Important dates</Heading>
    <dl class="facts">
      <DeadlineRows />
      <div>
        <dt>Workshop date</dt>
        <dd class="tabular">
          {site.workshopDate === TBA ? <Value of={TBA} /> : formatIsoDay(site.workshopDate)}
        </dd>
      </div>
    </dl>
    {deadlines.some((deadline) => deadline.due) && (
      <p class="note">
        Deadlines are Anywhere on Earth (AoE, UTC−12). See <a href={url("/dates/")}>all dates</a>.
      </p>
    )}
  </section>

  <section>
    <Heading id="scope">Scope</Heading>
    {cfp.scope.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <p>{cfp.goal}</p>
  </section>

  <section>
    <Heading id="topics">Topics of interest</Heading>
    <p>{cfp.topicsIntro}</p>
    <ul class="topics">
      {cfp.topics.map((topic) => (
        <li id={topicAnchor(topic.title)}>
          <strong class="topic-title">{topic.title}</strong> <span>{topic.description}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <Heading id="paper-categories">Paper categories</Heading>
    {cfp.paperTypes.map((type) => (
      <div class="entry">
        <h3>{type.title}</h3>
        <p>{type.description}</p>
        {!limitsUnknown && (
          <p class="entry__fact">
            <strong>Page limit:</strong> <Value of={type.pageLimit} />
          </p>
        )}
      </div>
    ))}
    {limitsUnknown && (
      <dl class="facts page-limits">
        <div>
          <dt>Page limits</dt>
          <dd>
            <Value of={TBA} />
          </dd>
        </div>
      </dl>
    )}
  </section>

  <section>
    <Heading id="submission">Submission details</Heading>
    <dl class="facts">
      <div>
        <dt>Submission system</dt>
        <dd>
          {site.submissionUrl === TBA ? (
            <Value of={site.submissionSystem} />
          ) : (
            <ExternalLink
              href={site.submissionUrl}
              class={site.submissionSystem === TBA ? "link-is-address" : undefined}
            >
              {site.submissionSystem === TBA ? site.submissionUrl : site.submissionSystem}
            </ExternalLink>
          )}
        </dd>
      </div>
      <div>
        <dt>Template</dt>
        <dd>
          <PaperTemplate />
        </dd>
      </div>
      <div>
        <dt>Review model</dt>
        <dd>
          <Value of={site.reviewModel} />
        </dd>
      </div>
      <div>
        <dt>Proceedings</dt>
        <dd>{cfp.proceedingsNote}</dd>
      </div>
      <div>
        <dt>Presentation</dt>
        <dd>{cfp.presentation}</dd>
      </div>
    </dl>
  </section>

  <section>
    <Heading id="policies">Submission policies</Heading>
    <dl class="facts">
      <div>
        <dt>Dual submission</dt>
        <dd>
          <Value of={cfp.dualSubmission} />
        </dd>
      </div>
      <div>
        <dt>Use of generative AI</dt>
        <dd>
          <Value of={cfp.generativeAi} />
        </dd>
      </div>
    </dl>
    <p class="note">
      Code of conduct, conflict of interest and ethics are on the{" "}
      <a href={url("/policies/")}>Policies page</a>.
    </p>
  </section>
</BaseLayout>
