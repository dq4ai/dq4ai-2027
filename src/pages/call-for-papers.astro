---
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import Value from "../components/Value.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCfp, getDeadlines, getSite } from "../lib/content";
import { formatAoE, formatIsoDay, TBA } from "../lib/dates";
import { url } from "../lib/paths";
import { hostDatesSentence, workshopTitle } from "../lib/view";

const [site, cfp, deadlines] = await Promise.all([getSite(), getCfp(), getDeadlines()]);
---

<BaseLayout slug="call-for-papers">
  <PageHeader
    title="Call for Papers"
    lede={`${workshopTitle(site)} (${site.acronym} ${site.year}), co-located with ${site.host.name}. ${hostDatesSentence(site)}`}
  />
  <p class="note no-print">
    Share this call: <a href={url("/cfp.txt")}>plain-text version</a> for mailing lists, or print
    this page.
  </p>

  <section>
    <Heading id="important-dates">Important dates</Heading>
    <dl class="facts">
      {deadlines.map((deadline) => (
        <div>
          <dt>{deadline.label}</dt>
          <dd class="tabular">
            {deadline.due ? (
              <time datetime={deadline.due.toISOString()}>{formatAoE(deadline.due)}</time>
            ) : (
              <span class="tba">To be announced</span>
            )}
          </dd>
        </div>
      ))}
      <div>
        <dt>Workshop</dt>
        <dd class="tabular">
          {site.workshopDate === TBA ? (
            <span class="tba">To be announced</span>
          ) : (
            formatIsoDay(site.workshopDate)
          )}
        </dd>
      </div>
    </dl>
    {deadlines.some((deadline) => deadline.due) && (
      <p class="note">
        Deadlines are Anywhere on Earth (AoE, UTC−12). See <a href={url("/dates/")}>all dates</a>.
      </p>
    )}
  </section>

  <section>
    <Heading id="scope">Scope</Heading>
    {cfp.scope.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <p>{cfp.goal}</p>
  </section>

  <section>
    <Heading id="topics">Topics of interest</Heading>
    <p>{cfp.topicsIntro}</p>
    <ol class="topics">
      {cfp.topics.map((topic) => (
        <li>
          <strong>{topic.title}</strong> {topic.description}
        </li>
      ))}
    </ol>
  </section>

  <section>
    <Heading id="paper-categories">Paper categories</Heading>
    {cfp.paperTypes.map((type) => (
      <div class="entry">
        <h3>{type.title}</h3>
        <p>{type.description}</p>
        <p class="entry__fact">
          <strong>Page limit:</strong> <Value of={type.pageLimit} />
        </p>
      </div>
    ))}
  </section>

  <section>
    <Heading id="submission">Submission and publication</Heading>
    <dl class="facts">
      <div>
        <dt>Submission system</dt>
        <dd>
          {site.submissionUrl === TBA ? (
            <Value of={site.submissionSystem} />
          ) : (
            <ExternalLink href={site.submissionUrl}>
              {site.submissionSystem === TBA ? site.submissionUrl : site.submissionSystem}
            </ExternalLink>
          )}
        </dd>
      </div>
      <div>
        <dt>Template</dt>
        <dd>
          <Value of={site.paperTemplate} />
        </dd>
      </div>
      <div>
        <dt>Review model</dt>
        <dd>
          <Value of={site.reviewModel} />
        </dd>
      </div>
      <div>
        <dt>Proceedings</dt>
        <dd>{cfp.proceedingsNote}</dd>
      </div>
      <div>
        <dt>Presentation</dt>
        <dd>{cfp.presentation}</dd>
      </div>
    </dl>
  </section>

  <section>
    <Heading id="policies">Policies</Heading>
    <dl class="facts">
      <div>
        <dt>Dual submission</dt>
        <dd>
          <Value of={cfp.dualSubmission} />
        </dd>
      </div>
      <div>
        <dt>Use of generative AI</dt>
        <dd>
          <Value of={cfp.generativeAi} />
        </dd>
      </div>
    </dl>
  </section>

  <section class="no-print">
    <Heading id="related-venues">Interest to EDBT/ICDT and related venues</Heading>
    <p>{cfp.relatedVenues.intro}</p>
    <ul>
      {cfp.relatedVenues.venues.map((venue) => (
        <li>
          <strong>{venue.name}</strong>, co-located with {venue.colocation}. {venue.focus}
        </li>
      ))}
    </ul>
    <p>{cfp.relatedVenues.distinction}</p>
  </section>
</BaseLayout>
