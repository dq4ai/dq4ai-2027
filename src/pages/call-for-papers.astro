---
import DeadlineRows from "../components/DeadlineRows.astro";
import ExternalLink from "../components/ExternalLink.astro";
import Heading from "../components/Heading.astro";
import PageHeader from "../components/PageHeader.astro";
import PaperTemplate from "../components/PaperTemplate.astro";
import Value from "../components/Value.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCfp, getDeadlines, getSite } from "../lib/content";
import { formatIsoDay, TBA } from "../lib/dates";
import { url } from "../lib/paths";
import {
  hostDatesSentence,
  isKnown,
  pageLimitsUnknown,
  pendingSentence,
  topicAnchor,
  workshopTitle,
} from "../lib/view";

const [site, cfp, deadlines] = await Promise.all([getSite(), getCfp(), getDeadlines()]);
const limitsUnknown = pageLimitsUnknown(cfp);
// Facts not yet known share one sentence instead of each taking a row of "To be announced".
const templateKnown =
  isKnown(site.paperTemplate) ||
  (site.paperTemplateUrl !== undefined && isKnown(site.paperTemplateUrl));
const systemKnown = isKnown(site.submissionSystem) || isKnown(site.submissionUrl);
const submissionPending = pendingSentence(
  [
    !systemKnown && "Submission system",
    !templateKnown && "Template",
    !isKnown(site.reviewModel) && "Review model",
  ].filter((label) => typeof label === "string"),
);
const policiesPending = pendingSentence(
  [
    !isKnown(cfp.dualSubmission) && "Dual submission",
    !isKnown(cfp.generativeAi) && "Use of generative AI",
  ].filter((label) => typeof label === "string"),
);
---

<BaseLayout slug="call-for-papers">
  <PageHeader
    title="Call for Papers"
    photo={site.cfpPhoto}
    lede={`${workshopTitle(site)} (${site.acronym} ${site.year}), co-located with ${site.host.name}. ${hostDatesSentence(site)}`}
  />
  <section>
    <Heading id="important-dates">Important dates</Heading>
    <dl class="facts">
      <DeadlineRows />
      <div>
        <dt>Workshop date</dt>
        <dd class="tabular">
          {site.workshopDate === TBA ? <Value of={TBA} /> : formatIsoDay(site.workshopDate)}
        </dd>
      </div>
    </dl>
    {deadlines.some((deadline) => deadline.due) && (
      <p class="note">
        Deadlines are Anywhere on Earth (AoE, UTC−12). See <a href={url("/dates/")}>all dates</a>.
      </p>
    )}
  </section>

  <section>
    <Heading id="scope">Scope</Heading>
    <p>{cfp.goal}</p>
    <details>
      <summary>More on the scope</summary>
      {cfp.scope.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </details>
  </section>

  <section>
    <Heading id="topics">Topics of interest</Heading>
    <p>{cfp.topicsIntro}</p>
    <ul class="topics">
      {cfp.topics.map((topic) => (
        <li id={topicAnchor(topic.title)}>
          <strong class="topic-title">{topic.title}</strong> <span>{topic.description}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <Heading id="paper-categories">Paper categories</Heading>
    <ul class="paper-types">
      {cfp.paperTypes.map((type) => (
        <li>
          <details>
            <summary>
              <h3>{type.title}</h3>
            </summary>
            <p>{type.description}</p>
            {!limitsUnknown && (
              <p class="entry__fact">
                <strong>Page limit:</strong> <Value of={type.pageLimit} />
              </p>
            )}
          </details>
        </li>
      ))}
    </ul>
    {limitsUnknown && (
      <dl class="facts page-limits">
        <div>
          <dt>Page limits</dt>
          <dd>
            <Value of={TBA} />
          </dd>
        </div>
      </dl>
    )}
  </section>

  <section>
    <Heading id="submission">Submission details</Heading>
    <dl class="facts">
      {systemKnown && (
        <div>
          <dt>Submission system</dt>
          <dd>
            {site.submissionUrl === TBA ? (
              <Value of={site.submissionSystem} />
            ) : (
              <ExternalLink
                href={site.submissionUrl}
                class={site.submissionSystem === TBA ? "link-is-address" : undefined}
              >
                {site.submissionSystem === TBA ? site.submissionUrl : site.submissionSystem}
              </ExternalLink>
            )}
          </dd>
        </div>
      )}
      {templateKnown && (
        <div>
          <dt>Template</dt>
          <dd>
            <PaperTemplate />
          </dd>
        </div>
      )}
      {isKnown(site.reviewModel) && (
        <div>
          <dt>Review model</dt>
          <dd>{site.reviewModel}</dd>
        </div>
      )}
      <div>
        <dt>Proceedings</dt>
        <dd>{cfp.proceedingsNote}</dd>
      </div>
      <div>
        <dt>Presentation</dt>
        <dd>{cfp.presentation}</dd>
      </div>
    </dl>
    {submissionPending && <p class="note">{submissionPending}</p>}
    <p class="more-link">
      <a href={url("/submission/")}>How to prepare and submit a paper</a>
    </p>
  </section>

  <section>
    <Heading id="policies">Submission policies</Heading>
    {policiesPending !== "" && <p>{policiesPending}</p>}
    {(isKnown(cfp.dualSubmission) || isKnown(cfp.generativeAi)) && (
      <dl class="facts">
        {isKnown(cfp.dualSubmission) && (
          <div>
            <dt>Dual submission</dt>
            <dd>{cfp.dualSubmission}</dd>
          </div>
        )}
        {isKnown(cfp.generativeAi) && (
          <div>
            <dt>Use of generative AI</dt>
            <dd>{cfp.generativeAi}</dd>
          </div>
        )}
      </dl>
    )}
    <p class="note">
      Code of conduct, conflict of interest and ethics are on the{" "}
      <a href={url("/policies/")}>Policies page</a>.
    </p>
  </section>
</BaseLayout>
