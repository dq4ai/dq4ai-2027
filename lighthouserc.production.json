{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "https://dq4ai.github.io/dq4ai-2027/",
        "https://dq4ai.github.io/dq4ai-2027/call-for-papers/",
        "https://dq4ai.github.io/dq4ai-2027/program/",
        "https://dq4ai.github.io/dq4ai-2027/organization/"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1200
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
