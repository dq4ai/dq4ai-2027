{
  "name": "dq4ai-2027",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website of the Second International Workshop on Data Quality for Artificial Intelligence (DQ4AI 2027).",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"dist/**/*.html\" \"dist-fixture/**/*.html\"",
    "lhci": "lhci autorun",
    "build:fixture": "DQ4AI_CONTENT_DIR=tests/fixtures/content-populated DQ4AI_OUT_DIR=dist-fixture DQ4AI_NOW=2026-12-11T12:00:00Z astro build",
    "serve": "node scripts/serve-static.mjs dist 4321",
    "serve:fixture": "node scripts/serve-static.mjs dist-fixture 4322"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.4.8",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.21.0",
    "ical.js": "^2.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
