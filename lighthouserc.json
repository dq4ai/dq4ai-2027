{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm serve",
      "startServerReadyPattern": "Serving",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4321/dq4ai-2027/",
        "http://localhost:4321/dq4ai-2027/call-for-papers/",
        "http://localhost:4321/dq4ai-2027/program/",
        "http://localhost:4321/dq4ai-2027/organization/"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/call-for-papers/).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1200
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/call-for-papers/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.99
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
